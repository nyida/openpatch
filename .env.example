# =============================================================================
# Algomarket — Environment Variables
# =============================================================================

# Whale data (SQLite)
# Local: auto-detects PolymarketAnalysis or ./storage/whale_data.db
# Render: ship storage/whale_data.db OR set WHALE_DB_PATH=/var/data/whale_data.db on a disk
WHALE_DB_PATH=
WHALE_SCRAPER_DIR=~/Desktop/PolymarketAnalysis
# Persistent auth + optional DB root (Render disk mount, e.g. /var/data)
DATA_DIR=

# Existing venue API overrides (optional)
POLY_GAMMA_URL=https://gamma-api.polymarket.com
KALSHI_API_URL=https://api.elections.kalshi.com/trade-api/v2

# PMXT — cross-venue arbitrage scanner (https://pmxt.dev)
PMXT_API_KEY=

# Dev API auth
ALGOMARKET_API_KEY=algomarket-dev-key

# =============================================================================
# Auth + Stripe (ported from AuditGPT pattern; additive — does not gate analytics)
# =============================================================================

# JWT signing secret (required in production)
AUTH_SECRET=

# Public site URL (verification email links)
# APP_URL=https://algomarket.onrender.com
# NEXT_PUBLIC_APP_URL=https://algomarket.onrender.com

# Resend — verification emails (domain algomarket.lol verified)
# RESEND_API_KEY=re_…
# EMAIL_FROM=Algomarket <noreply@algomarket.lol>

# Stripe Pro (~$20/mo) — reuse AuditGPT Stripe account; use sk_… not rk_
STRIPE_SECRET_KEY=
# Same catalog price as AuditGPT Pro (or create a dedicated Algomarket Pro price)
STRIPE_PRICE_ID=price_1TGK7PIoKNrNUABO1xjgcAsA
STRIPE_WEBHOOK_SECRET=
# Webhook endpoint to add in Stripe Dashboard:
#   https://algomarket.onrender.com/api/auth/webhook
# Events: checkout.session.completed, customer.subscription.deleted
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SUCCESS_URL=https://algomarket.onrender.com/paywall?success=1
STRIPE_CANCEL_URL=https://algomarket.onrender.com/paywall?canceled=1

# Local only — NEVER set to 1 on Render
ALLOW_DEV_SUBSCRIBE=0

# Google OAuth (GIS)
# Authorized JS origins: http://localhost:3000, https://algomarket.onrender.com, https://algomarket.lol
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# ALLOW_DEV_OAUTH=1

# --- Prediction Market APIs ---

# PolyRouter — unified API for 7 platforms (free open beta)
# Get key: https://polyrouter.io
POLYROUTER_API_KEY=

# SimpleFunctions — Kalshi + Polymarket unified (free during beta, no key for public endpoints)
# Optional key for higher rate limits
SIMPLEFUNCTIONS_API_KEY=
# Legacy alias (supported):
SIMPLECLOCK_API_KEY=

# Dome — orderbooks (EOL April 2026; acquired by Polymarket)
# Get key: https://domeapi.io
DOME_API_KEY=

# PredScope, Manifold, Metaculus — no keys required (public endpoints)

# --- Crypto APIs ---

# CoinPaprika — no key required (20,000 calls/month free)

# CoinGecko — optional key for higher limits (10,000 calls/month free tier)
COINGECKO_API_KEY=

# CoinMarketCap — requires key (10,000 monthly credits)
COINMARKETCAP_API_KEY=

# --- Traditional Finance ---

# FRED (Federal Reserve) — free, unlimited with key
# Get key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- Hyperliquid / AI Tools ---

# GoldRush — Hyperliquid ecosystem data
GOLDRUSH_API_KEY=

# =============================================================================
# Legacy (OpenPatch / other — not used by Algomarket core)
# =============================================================================

# DATABASE_URL="postgresql://user:password@localhost:5432/openpatch?schema=public"
# ENCRYPTION_KEY="32-byte-hex-key-for-api-keys"
